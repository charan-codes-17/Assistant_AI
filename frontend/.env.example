# Backend origin used by the Next.js rewrite in next.config.ts.
#
# SERVER-SIDE ONLY. This variable is read when the Next.js server builds its route manifest
# and is deliberately NOT prefixed with NEXT_PUBLIC_, so it is never inlined into the client
# bundle. The browser only ever calls same-origin "/api/...".
#
# Local development default: http://localhost:8000 (used when this is unset).
# Production: the deployed backend origin, e.g. https://your-backend-host
API_BASE_URL=
