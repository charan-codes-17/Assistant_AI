# Nebius Token Factory API Configuration
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model Configurations (Never hardcoded in codebase)
# Fast tier: routing, extraction, onboarding, plain chat
CHAT_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Reasoning tier: relevance judgment, intervention, contradiction checks
CHAT_MODEL_REASONING=Llama-3_1-Nemotron-Ultra-253B-v1

# Embedding Configuration
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
# Total budget (seconds) for the query embedding call in retrieval. The query path hedges: one
# request, plus a second identical request if the first is slow (see EMBEDDING_HEDGE_SECONDS);
# whichever finishes first wins. When the budget is exhausted the retrieval fail-open applies.
EMBEDDING_TIMEOUT_SECONDS=5
# Seconds with no query-embedding result before the hedge fires a second identical request
# concurrently (query path only). Must be below EMBEDDING_TIMEOUT_SECONDS.
EMBEDDING_HEDGE_SECONDS=1.5
# Per-attempt timeout (seconds) for all non-query (batch) embedding calls, e.g. extraction
# dedupe and edit_record. One retry is attempted, so the total budget is this value * 2.
EMBEDDING_BATCH_TIMEOUT_SECONDS=20

# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Bot signup: comma-separated invite codes accepted by /start <code> (case-sensitive).
# Empty means no new users can sign up.
INVITE_CODES=
# Max users the bot will sign up.
BOT_MAX_USERS=25

# Whisper STT (local, CPU int8). Model directory = WHISPER_MODEL_ROOT/whisper-<name>.
WHISPER_MODEL_NAME=small
# Local default; the container sets WHISPER_MODEL_ROOT=/app/whisper_models via the Dockerfile ENV.
WHISPER_MODEL_ROOT=backend/whisper_models
# CPU threads used by faster-whisper (int8) transcription.
WHISPER_CPU_THREADS=2
# Voice notes longer than this many seconds are refused without downloading them.
VOICE_MAX_SECONDS=60
# Hard timeout (seconds) for a single voice transcription.
VOICE_TRANSCRIBE_TIMEOUT_SECONDS=60

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-secret

# Retrieval & Relevance configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.40
RELEVANCE_MIN_CONFIDENCE=50

# Retrieval timeouts (seconds)
RETRIEVAL_TIMEOUT_SECONDS=15
INTERVENTION_TIMEOUT_SECONDS=30

# Reminder scheduler (deterministic; no LLM or embedding calls)
# Fire a reminder this many minutes before a task's due_at.
REMINDER_LEAD_MINUTES=60
# Interval (seconds) between scheduler reminder scans.
REMINDER_SCAN_SECONDS=30
# Skip reminders for tasks overdue by more than this many hours.
REMINDER_MAX_OVERDUE_HOURS=24
# Max reminders selected per user per scan.
REMINDER_MAX_PER_USER_PER_TICK=2
# Minutes the reminder "Snooze" button postpones a task by.
REMINDER_SNOOZE_MINUTES=30

# Deduplication
# Cosine similarity threshold for deduplicating knowledge records.
DEDUPE_THRESHOLD=0.90
# Pending records older than this many hours no longer count as dedupe duplicates
# (confirmed rows always count). Stale pending rows are left in place.
PENDING_DEDUPE_TTL_HOURS=24

# Onboarding parsers (import / questionnaire)
# Max characters accepted for an import payload or the combined questionnaire transcript.
# Larger input is rejected with an error; input is never truncated silently.
ONBOARDING_MAX_CHARS=12000
# Max candidate records staged from a single onboarding parse; extras are dropped (over_cap).
ONBOARDING_MAX_CANDIDATES=40

